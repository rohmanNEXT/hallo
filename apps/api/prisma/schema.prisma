// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  password          String?
  name              String?
  phone             String?
  career            String?
  education         String?
  experience        String?
  resume            String?
  website           String?
  socialMedia       String?
  aboutMe           String?
  organizationExp   String?
  skills            String?
  jobPreferences    String?
  city              String?
  expectedSalary    Int?
  workOption        String?
  licenses          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  applications      Application[]
  savedJobs         SavedJob[]
  @@map("users")
}

model Company {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  password          String
  logo              String?
  description       String?
  industry          String?
  totalEmployees    Int?
  website           String?
  linkedin          String?
  instagram         String?
  location          String?
  culture           String?
  isPremium         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  jobs              Job[]
  @@map("companies")
}

model Job {
  id                String   @id @default(cuid())
  companyId         String
  title             String
  description       String
  salary            Int?
  workOption        String
  workType          String
  experienceLevel   String
  educationLevel    String
  location          String
  province          String?
  city              String?
  isUrgent          Boolean  @default(false)
  requirements      String?
  skills            String?
  benefits          String?
  postedAt          DateTime @default(now())
  updatedAt         DateTime @updatedAt
  company           Company  @relation(fields: [companyId], references: [id])
  applications      Application[]
  savedJobs         SavedJob[]
  categories        JobCategory[]
  @@map("jobs")
}

model Application {
  id                String   @id @default(cuid())
  userId            String
  jobId             String
  status            String   @default("pending")
  appliedAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id])
  job               Job      @relation(fields: [jobId], references: [id])
  @@unique([userId, jobId])
  @@map("applications")
}

model SavedJob {
  id                String   @id @default(cuid())
  userId            String
  jobId             String
  savedAt           DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id])
  job               Job      @relation(fields: [jobId], references: [id])
  @@unique([userId, jobId])
  @@map("saved_jobs")
}

model Category {
  id                String   @id @default(cuid())
  name              String   @unique
  jobs              JobCategory[]
  @@map("categories")
}

model JobCategory {
  id                String   @id @default(cuid())
  jobId             String
  categoryId        String
  job               Job      @relation(fields: [jobId], references: [id])
  category          Category @relation(fields: [categoryId], references: [id])
  @@unique([jobId, categoryId])
  @@map("job_categories")
}

model Sample {
  id   Int    @id @default(autoincrement())
  name String
  code String
}
